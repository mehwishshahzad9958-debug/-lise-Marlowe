# ---------------------------------------------------------------
# Files Git should never track for this Next.js project
# ---------------------------------------------------------------

# Dependencies (re-created by `npm install`)
/node_modules

# Next.js build and dev output (re-created by `next dev` / `next build`)
/.next/
/out/
/build

# Environment variables: secrets (API keys, passwords) live here.
# Never commit these. `.env.example` (placeholders only) is NOT ignored.
.env
.env*.local

# TypeScript build cache and Next.js generated types
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment (Vercel)
.vercel

# Operating system / editor clutter
.DS_Store
Thumbs.db

*.tsbuildinfo

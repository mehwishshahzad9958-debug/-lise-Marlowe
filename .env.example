# ---------------------------------------------------------------
# Environment variables for this project: PLACEHOLDERS ONLY.
#
# Copy this file to `.env.local` and fill in your own values there.
# `.env.local` is ignored by Git and must NEVER be committed or shared.
# Restart `npm run dev` after changing it.
# ---------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# Where: Supabase dashboard → your project → "Connect" (or Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose by design.
# Not used by the registration feature; kept for possible future browser features.
# Where: Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET key (starts with sb_secret_). SERVER-ONLY.
# Used only by lib/supabase/server.ts to insert registrations.
# Never add a NEXT_PUBLIC_ prefix, never paste it into code or chat, never commit it.
# If it leaks: delete it in Project Settings → API Keys and create a new one.
# Where: Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=
